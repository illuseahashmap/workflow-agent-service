{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:workflow-agent:rag:evaluation-dataset:v2",
  "title": "RAG EvaluationDatasetVersion manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["datasetId", "version", "schemaVersion", "status", "tenantRef", "caseFileSha256", "knowledgeSnapshotId", "knowledgeSnapshotSha256", "indexBindings", "scoringRuleVersion", "difficultyRubricVersion", "annotationGuidelineVersion", "createdBy", "createdAt", "splitGroupRegistrySha256"],
  "properties": {
    "datasetId": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "schemaVersion": {"const": 2},
    "status": {"enum": ["DRAFT", "LOCKED"]},
    "tenantRef": {"type": "string", "minLength": 1},
    "caseFileSha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "knowledgeSnapshotId": {"type": "string", "minLength": 1},
    "knowledgeSnapshotSha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "indexBindings": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true,
      "items": {"type": "object", "additionalProperties": false, "required": ["sourceCode", "indexVersionId"],
        "properties": {"sourceCode": {"type": "string", "minLength": 1}, "indexVersionId": {"type": "string", "minLength": 1}}}},
    "scoringRuleVersion": {"type": "string", "minLength": 1},
    "difficultyRubricVersion": {"type": "string", "minLength": 1},
    "annotationGuidelineVersion": {"type": "string", "minLength": 1},
    "splitGroupRegistrySha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "createdBy": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "lockedAt": {"type": "string", "format": "date-time"},
    "reviewers": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "LOCKED"}}, "required": ["status"]}, "then": {"required": ["lockedAt", "reviewers"]}}
  ]
}
