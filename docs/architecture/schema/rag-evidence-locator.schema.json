{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:workflow-agent:rag:evidence-locator:v1",
  "title": "Versioned source locator, never a file path or executable expression",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"enum": ["TEXT_SECTION", "PDF_REGION", "TABLE_CELLS", "FIGURE_REGION"]},
    "sectionId": {"type": "string", "minLength": 1},
    "artifactHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "elementId": {"type": "string", "minLength": 1},
    "pageRegions": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["pageIndex", "x0", "y0", "x1", "y1"],
        "properties": {
          "pageIndex": {"type": "integer", "minimum": 0},
          "x0": {"type": "number", "minimum": 0, "maximum": 1},
          "y0": {"type": "number", "minimum": 0, "maximum": 1},
          "x1": {"type": "number", "minimum": 0, "maximum": 1},
          "y1": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "rowIds": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "columnIds": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "assetHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "TEXT_SECTION"}}},
      "then": {"required": ["sectionId"], "not": {"anyOf": [{"required": ["artifactHash"]}, {"required": ["elementId"]}, {"required": ["pageRegions"]}, {"required": ["rowIds"]}, {"required": ["columnIds"]}, {"required": ["assetHash"]}]}},
      "else": {"required": ["artifactHash", "elementId", "pageRegions"], "not": {"required": ["sectionId"]}}},
    {"if": {"properties": {"kind": {"const": "TABLE_CELLS"}}},
      "then": {"required": ["rowIds", "columnIds"]},
      "else": {"not": {"anyOf": [{"required": ["rowIds"]}, {"required": ["columnIds"]}]}}},
    {"if": {"properties": {"kind": {"const": "FIGURE_REGION"}}},
      "then": {"required": ["assetHash"]}, "else": {"not": {"required": ["assetHash"]}}}
  ]
}
