{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["caseId", "schemaVersion", "primaryDomain", "sourceSections", "requires", "reviewStatus", "independentReview"],
  "properties": {
    "caseId": {"type": "string", "minLength": 1},
    "schemaVersion": {"const": 1},
    "primaryDomain": {"type": "string", "minLength": 1},
    "reviewStatus": {"const": "AUTHOR_SELF_REVIEWED"},
    "independentReview": {"const": false},
    "sourceSections": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["evidenceId", "quote"],
      "properties": {"evidenceId": {"type": "string", "minLength": 1}, "quote": {"type": "string", "minLength": 1}}
    }},
    "requires": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["fromGroup", "toGroup", "intermediateFact", "purpose"],
      "properties": {
        "fromGroup": {"type": "integer", "minimum": 0}, "toGroup": {"type": "integer", "minimum": 0},
        "intermediateFact": {"type": "string", "minLength": 1}, "purpose": {"type": "string", "minLength": 1}
      }
    }}
  }
}
