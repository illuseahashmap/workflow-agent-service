WORKFLOW_DB_URL=jdbc:postgresql://localhost:5432/workflow_agent
WORKFLOW_DB_USERNAME=workflow_agent
WORKFLOW_DB_PASSWORD=workflow_agent

# Required by workflow security in local development.
# Generate with:
#   powershell -NoProfile -Command "[Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))"
WORKFLOW_MASTER_KEY_BASE64=
WORKFLOW_LOCAL_DEV_SECRET=change-me-local-dev-secret
