WORKFLOW_DB_URL=jdbc:postgresql://localhost:5432/workflow_agent
WORKFLOW_DB_USERNAME=workflow_agent
WORKFLOW_DB_PASSWORD=workflow_agent

# Required by workflow security in local development.
# Generate with:
#   powershell -NoProfile -Command "[Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))"
WORKFLOW_MASTER_KEY_BASE64=
WORKFLOW_LOCAL_DEV_SECRET=change-me-local-dev-secret

# Native Java processes do not automatically load this file. Export these values.
SPRING_PROFILES_ACTIVE=local
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379
# Required signing secret, independent from the AES key above. Use a random value.
WORKFLOW_AUTH_TOKEN_SECRET=
WORKFLOW_BOOTSTRAP_ADMIN_ENABLED=true
WORKFLOW_BOOTSTRAP_ADMIN_USERNAME=admin
# At least 12 characters. Existing users are not password-reset on startup.
WORKFLOW_BOOTSTRAP_ADMIN_PASSWORD=
WORKFLOW_GRAPH_ENABLED=false
